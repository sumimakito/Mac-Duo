// Settings panel translations.
"Lid angle" = "Ángulo de la pantalla";
"This Mac has no lid angle sensor. Only some MacBook models have one." = "Este Mac no tiene sensor de ángulo de pantalla. Solo algunos modelos de MacBook lo incluyen.";
"Depth effect" = "Efecto de profundidad";
"Leans the screen away as the lid closes." = "Inclina la pantalla hacia atrás a medida que se cierra la tapa.";
"Live rendering" = "Renderizado en vivo";
"Off holds the frame from when the effect started." = "Si está desactivado, se mantiene el fotograma del momento en que comenzó el efecto.";
"Start" = "Inicio";
"Timeout" = "Tiempo de espera";
"Ends the effect once the angle stops changing." = "Termina el efecto cuando el ángulo deja de cambiar.";
"Start angle" = "Ángulo de inicio";
"The effect starts at this angle." = "El efecto comienza en este ángulo.";
"Full effect after" = "Efecto completo tras";
"Degrees of further closing to reach full strength." = "Grados adicionales de cierre para alcanzar la intensidad máxima.";
"Look" = "Aspecto";
"Blur" = "Desenfoque";
"Blur radius at the far edge." = "Radio de desenfoque en el borde más lejano.";
"Blur spread" = "Alcance del desenfoque";
"0 blurs the far edge only, 100 the whole picture." = "0 desenfoca solo el borde más lejano, 100 desenfoca toda la imagen.";
"Dimming" = "Oscurecimiento";
"How dark the far edge goes." = "Qué tan oscuro se vuelve el borde más lejano.";
